{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.claude",
      "!**/*.tsbuildinfo",
      "!lint/fixtures"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": { "noFloatingPromises": "error" },
      "suspicious": { "noTsIgnore": "error", "noFocusedTests": "error" },
      "security": { "noGlobalEval": "error" }
    }
  },
  "plugins": [
    "./lint/no-sql-raw.grit",
    "./lint/no-coerce-boolean.grit",
    {
      "path": "./lint/no-stage-branching.grit",
      "includes": ["**", "!**/*.test.ts", "!test/**"]
    }
  ]
}
