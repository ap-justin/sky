    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
